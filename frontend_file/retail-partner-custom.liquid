<style>
  .custom-form {
    max-width: 700px;
    margin: 0 auto;
    padding-block: 20px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    padding-block: 20px;
  }

  @media screen and (max-width: 650px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .field {
      grid-column: span 2;
    }
  }

  .form-grid textarea {
    resize: vertical;
  }

  .file_upload {
    position: relative;
  }

  .file_upload input[type='file'] {
    opacity: 0;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .file_upload .customLabel {
    display: flex;
    align-items: center;
    width: 100%; /* span the full field width */
    gap: 0.5em; /* space between text & icon */
  }

  .file_upload .customLabel .placeholder {
    font-style: normal; /* remove italics */
    flex: 1; /* take up remaining space */
  }

  .file_upload .customLabel .upload-icon {
    flex-shrink: 0; /* don’t let the icon get squished */
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  .fileName {
    font-weight: 600;
    font-style: italic;
  }

  .success_msg {
    display: none;
    align-items: center;
    gap: 10px;
    background-color: #caffca;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
  }

  .success_msg svg {
    min-width: 30px;
    min-height: 30px;
    padding: 5px;
    border-radius: 20px;
    border: 1px solid black;
  }
</style>

