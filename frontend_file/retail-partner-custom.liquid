<script>
  document.addEventListener('DOMContentLoaded', function () {
    const fileInput = document.querySelector('input[type="file"]');
    const fileNameSpan = document.querySelector('.fileName');

    fileInput.addEventListener('change', function () {
      const placeholder = document.querySelector('.file_upload .placeholder');
      if (fileInput.files.length > 0) {
        fileNameSpan.textContent = fileInput.files[0].name;
        placeholder.style.display = 'none';
      } else {
        fileNameSpan.textContent = '';
        placeholder.style.display = 'inline';
      }
    });
  });
</script>
<script>
  let file;
  function storeFile(e) {
    file = e.target.files[0];
  }

  async function submitForm(e) {
    e.preventDefault();

    const formData = new FormData();

    // const rawPartnerType = document.getElementById("customPartnerType").value;
    // const cleanedPartnerType = rawPartnerType.replace(/\s*\(.*?\)/g, '').trim();

    formData.append('first_name', document.getElementById('customFirstName').value.trim());
    formData.append('last_name', document.getElementById('customLastName').value.trim());
    formData.append('email', document.getElementById('customEmail').value.trim());
    formData.append('phone', document.getElementById('customPhone').value.trim());
    formData.append('address1', document.getElementById('customAddress').value.trim());

    const additionalAddress = document.getElementById('customAdditionalAddress').value.trim();
    formData.append('address2', additionalAddress || '');

    formData.append('city', document.getElementById('customCity').value.trim());
    formData.append('province', document.getElementById('customState').value.trim());
    formData.append('country', document.getElementById('customCountry').value.trim());
    formData.append('zip', document.getElementById('customPostalCode').value.trim());

    // formData.append("partner_type", cleanedPartnerType); // already trimmed

    formData.append('website', document.getElementById('customWebite').value.trim());
    formData.append('tax_id', document.getElementById('customTax').value.trim());
    formData.append('business_description', document.getElementById('business_description').value.trim());

    formData.append('tax_file', file);

    const submitBtn = document.getElementById('customFormSubmit');
    const success_msg = document.querySelector('.success_msg');
    submitBtn.disabled = true;
    // submitBtn.classList.add("is-loading");

    const response = await fetch('https://hocky-name-generator-seven.vercel.app/api/createPartner', {
      method: 'POST',
      headers: {},
      body: formData,
    });
    const data = await response.json();
    console.log(data);

    success_msg.querySelector('svg').style.fill = data.success ? '#1B7F4A' : '#C62828 ';
    success_msg.querySelector('svg').style.borderColor = data.success ? '#1B7F4A' : '#C62828 ';
    success_msg.querySelector('span').style.color = data.success ? '#1B7F4A' : '#C62828 ';
    success_msg.style.backgroundColor = data.success ? '#E6F4EA' : '#FDEAEA';
    // success_msg.querySelector("span").textContent = data.message;

    let messageToShow;

    if (data.success) {
      messageToShow = data.message;
    } else {
      // data.message is an object with 'errors' key
      const errors = data.message.errors;
      messageToShow = Object.entries(errors)
        .map(([field, messages]) =>
          field === 'email' ? `Email ${messages[0]}` : field === 'phone' ? messages[0] : 'Something Went Wrong'
        )
        .join(' <br> ');
    }

    success_msg.querySelector('span').innerHTML = messageToShow;

    success_msg.style.display = 'flex';
    submitBtn.disabled = false;
    submitBtn.querySelector('.btn-loader').style.opacity = '0';
    submitBtn.querySelector('.btn-text').style.opacity = '1';

    // submitBtn.classList.remove("is-loading");
  }
</script>
